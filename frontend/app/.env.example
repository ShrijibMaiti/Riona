# Copy to .env.local. Vite reads it at start-up (restart `npm run dev` after a change).

# Where the API lives, as the browser sees it. Must match the backend's API_PREFIX.
VITE_API_BASE_URL=/api/v1

# Dev server only: where /api is proxied to (the backend).
VITE_API_PROXY_TARGET=http://localhost:3000
