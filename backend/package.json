{
  "name": "@riona/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/migrate.ts --reset",
    "db:seed": "tsx db/seed/import-fixture.ts",
    "db:types": "tsx db/generate-types.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@riona/shared": "*",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.27.4",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
