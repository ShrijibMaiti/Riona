# Copy to backend/.env. Loaded by src/config.ts at start-up; real environment variables win.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Every route lives under this prefix. The frontend calls VITE_API_BASE_URL, which must match.
API_PREFIX=/api/v1
LOG_LEVEL=info

# Matches docker-compose.yml (5433 on the host, so a locally installed Postgres on 5432 doesn't clash).
DATABASE_URL=postgres://riona:riona@localhost:5433/riona
DATABASE_POOL_MAX=10

# Signs the session cookie. At least 32 random characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-at-least-32-random-characters-please

# Where the frontend is served from (links in emails, SSO redirects).
APP_ORIGIN=http://localhost:5173

# Mail: Mailpit from docker-compose in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Riona <no-reply@riona.local>"

# The organisation's clock. Dates the API returns ("today") are in this zone.
TZ=Asia/Kolkata
# Development: pin the server clock to the demo data's "today" (Fri 6 Nov 2026), so dashboards line up with the
# seed. Remove it to use the real clock. Ignored in production.
CLOCK_FIXED_NOW=2026-11-06T11:00:00+05:30

# Client-portal payments: simulated (dev/test default: confirms at once), webhook (a real gateway confirms by
# signed POST /api/v1/webhooks/payments), or none. Never simulated in production.
# PAYMENT_GATEWAY=simulated
# PAYMENT_WEBHOOK_SECRET=a-long-random-shared-secret

# Uploaded files: a local directory (mount a persistent volume in production) and the size limit.
# STORAGE_DIR=var/uploads
# UPLOAD_MAX_MB=10

# Single sign-on (OpenID Connect). Register the redirect URI <APP_ORIGIN>/api/v1/auth/sso/google/callback (and
# .../microsoft/callback) with the provider. Leave empty to offer password sign-in only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=organizations
